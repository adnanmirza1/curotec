<style>
.centered-image-box {
  justify-content: center;
  align-items: center;
  text-align: center;
  display: flex;
  flex-direction: column;
}

/* Carousel Styles */
.case-study-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.case-study-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.carousel-nav-btn:hover {
  background: #f8f9fa !important;
  border-color: #0066cc !important;
}

.carousel-nav-btn:active {
  transform: scale(0.95);
}

/* Responsive Design */
@media (max-width: 768px) {
  .carousel-container {
    gap: 20px !important;
  }
  
  .case-study-card {
    flex: 0 0 300px !important;
    min-width: 300px !important;
    padding: 24px !important;
  }
  
  .case-study-card h3 {
    font-size: 18px !important;
  }
}

@media (max-width: 480px) {
  .case-study-card {
    flex: 0 0 280px !important;
    min-width: 280px !important;
    padding: 20px !important;
  }
  
  .case-study-card h3 {
    font-size: 16px !important;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('caseStudiesCarousel');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    if (!carousel || !prevBtn || !nextBtn) {
        console.log('Carousel elements not found');
        return;
    }
    
    const cardWidth = 350; // Width of each card
    const gap = 30; // Gap between cards
    let currentIndex = 0;
    const totalCards = carousel.children.length;
    
    // Calculate how many cards can be visible
    function getCardsPerView() {
        return Math.floor(carousel.offsetWidth / (cardWidth + gap));
    }
    
    let cardsPerView = getCardsPerView();
    
    // Update navigation buttons state
    function updateNavButtons() {
        const maxIndex = Math.max(0, totalCards - cardsPerView);
        
        // Previous button
        if (currentIndex <= 0) {
            prevBtn.style.opacity = '0.5';
            prevBtn.style.cursor = 'not-allowed';
            prevBtn.style.borderColor = '#ddd';
            prevBtn.style.color = '#999';
        } else {
            prevBtn.style.opacity = '1';
            prevBtn.style.cursor = 'pointer';
            prevBtn.style.borderColor = '#333';
            prevBtn.style.color = '#333';
        }
        
        // Next button
        if (currentIndex >= maxIndex) {
            nextBtn.style.opacity = '0.5';
            nextBtn.style.cursor = 'not-allowed';
            nextBtn.style.borderColor = '#ddd';
            nextBtn.style.color = '#999';
        } else {
            nextBtn.style.opacity = '1';
            nextBtn.style.cursor = 'pointer';
            nextBtn.style.borderColor = '#333';
            nextBtn.style.color = '#333';
        }
    }
    
    // Scroll to specific index
    function scrollToIndex(index) {
        const scrollAmount = index * (cardWidth + gap);
        carousel.scrollTo({
            left: scrollAmount,
            behavior: 'smooth'
        });
        currentIndex = index;
        updateNavButtons();
        console.log('Scrolled to index:', index, 'Scroll amount:', scrollAmount);
    }
    
    // Next button click
    nextBtn.addEventListener('click', function() {
        const maxIndex = Math.max(0, totalCards - cardsPerView);
        if (currentIndex < maxIndex) {
            scrollToIndex(currentIndex + 1);
        }
        console.log('Next clicked. Current index:', currentIndex, 'Max index:', maxIndex);
    });
    
    // Previous button click
    prevBtn.addEventListener('click', function() {
        if (currentIndex > 0) {
            scrollToIndex(currentIndex - 1);
        }
        console.log('Previous clicked. Current index:', currentIndex);
    });
    
    // Handle window resize
    window.addEventListener('resize', function() {
        const newCardsPerView = getCardsPerView();
        if (newCardsPerView !== cardsPerView) {
            cardsPerView = newCardsPerView;
            updateNavButtons();
        }
    });
    
    // Add touch/swipe support for mobile
    let startX = 0;
    let endX = 0;
    
    carousel.addEventListener('touchstart', function(e) {
        startX = e.touches[0].clientX;
    });
    
    carousel.addEventListener('touchend', function(e) {
        endX = e.changedTouches[0].clientX;
        handleSwipe();
    });
    
    function handleSwipe() {
        const swipeThreshold = 50;
        const diff = startX - endX;
        
        if (Math.abs(diff) > swipeThreshold) {
            if (diff > 0 && currentIndex < totalCards - cardsPerView) {
                // Swipe left - next
                scrollToIndex(currentIndex + 1);
            } else if (diff < 0 && currentIndex > 0) {
                // Swipe right - previous
                scrollToIndex(currentIndex - 1);
            }
        }
    }
    
    // Initialize
    updateNavButtons();
    console.log('Carousel initialized with', totalCards, 'cards');
});
</script>